# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real passwords or API keys.
# Real environment variables override anything set here.

# --- Database selection ---
# Leave empty to use the in-memory H2 database, or set to "postgres".
SPRING_PROFILES_ACTIVE=

# --- H2 (default, in-memory) ---
DB_URL=jdbc:h2:mem:testdb
DB_USERNAME=sa
DB_PASSWORD=
H2_CONSOLE_ENABLED=true

# --- PostgreSQL (used when SPRING_PROFILES_ACTIVE=postgres) ---
POSTGRES_URL=jdbc:postgresql://localhost:5432/spockdemo
POSTGRES_DB=spockdemo
POSTGRES_USER=spockdemo
POSTGRES_PASSWORD=change-me

# --- External ranking service (optional) ---
# Leave RANKING_API_URL empty to return a default "Unranked" rank.
RANKING_API_URL=
RANKING_API_KEY=

# --- Logging ---
SHOW_SQL=false
